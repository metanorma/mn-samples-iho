<bibitem id="iso-19115-2003" type="standard" schema-version="v1.5.6" anchor="iso-19115-2003" semx-id="_d1d72a70-d762-292f-4ddc-e77929199d4a"><biblio-tag>[5]<tab/></biblio-tag>
