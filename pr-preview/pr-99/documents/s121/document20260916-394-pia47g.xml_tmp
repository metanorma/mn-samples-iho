<name>Geographic information/Geomatics</name>

        <identifier id="_679e0221-e6db-32dd-c3f3-a8bc89583269">ISO/TC 211</identifier><fmt-identifier><tt><semx element="identifier" source="_679e0221-e6db-32dd-c3f3-a8bc89583269">ISO/TC 211</semx></tt></fmt-identifier>
