<name>Geographic information/Geomatics</name>

        <identifier id="_25098330-c676-c0a2-ba21-7ffbd06527e4">ISO/TC 211</identifier><fmt-identifier><tt><semx element="identifier" source="_25098330-c676-c0a2-ba21-7ffbd06527e4">ISO/TC 211</semx></tt></fmt-identifier>
