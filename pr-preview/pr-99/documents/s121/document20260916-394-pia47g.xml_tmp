<name>Geographic information/Geomatics</name>

        <identifier id="_87ab9fef-6e37-0792-d171-c4d301521ebc">ISO/TC 211</identifier><fmt-identifier><tt><semx element="identifier" source="_87ab9fef-6e37-0792-d171-c4d301521ebc">ISO/TC 211</semx></tt></fmt-identifier>
      </subdivision>
