<title language="en" type="main">IHO Universal Hydrographic Data Model</title>

  
<title language="fr" type="main">Modèle universel de données hydrographiques de l’OHI</title>

  <uri type="pdf">https://iho.int/uploads/user/pubs/standards/s-100/S-100_Version_1.0.0.pdf</uri><docidentifier type="metanorma-ordinal">[2]</docidentifier>
