<clause id="sec-party-member-block" anchor="sec-party-member-block" obligation="normative" semx-id="_726c6f32-bb61-5e0d-374a-aef400bcef89">
<title id="_20af5744-37a3-c437-e633-d466bbde01e7" semx-id="_e151cb96-1751-7288-bf5b-1536ad91cdde">Party Member Block</title><fmt-title depth="4" id="_937971d3-cf8e-0077-c16b-b851e372d43d"><span class="fmt-caption-label">2<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span>2</span><span class="fmt-caption-delim"><tab/></span><semx element="title" source="_20af5744-37a3-c437-e633-d466bbde01e7">Party Member Block</semx></fmt-title><fmt-xref-label><span class="fmt-element-name">Clause</span> 2<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span>5<span class="fmt-autonum-delim">.</span>2</fmt-xref-label>
<p id="_84d30d92-9016-3785-0715-626e502769bc" semx-id="_84d30d92-9016-3785-0715-626e502769bc">A party may be a group and have members. A Party Block may be identified as a Group and have references to its members. A member may have a particular share of a group. The Party Member Block carries the attribute partyShare which indicates the share of a party.</p>

<table id="tbl-partymemberblock-optional" anchor="tbl-partymemberblock-optional" semx-id="_e42e7cf8-11ae-a381-c9e8-5e9551f5fd0b" autonum="2-10">
