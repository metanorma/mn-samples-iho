<name>Geographic information/Geomatics</name>

        <identifier id="_15076950-8ed7-19f2-11ed-c79db79ebeec">ISO/TC 211</identifier><fmt-identifier><tt><semx element="identifier" source="_15076950-8ed7-19f2-11ed-c79db79ebeec">ISO/TC 211</semx></tt></fmt-identifier>
      </subdivision>
      <abbreviation>ISO</abbreviation>
