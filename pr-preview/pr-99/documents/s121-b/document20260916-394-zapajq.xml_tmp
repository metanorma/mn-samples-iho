<image id="_b1445828-73e2-b93e-d6a7-1bf0981c2245" src="/__w/mn-samples-iho/mn-samples-iho/_site/documents/s121-b/_tmp_images_5e15ef4a-a806-464e-9f8f-9a9259888e58/e37192df-a2ea-49ab-9d15-0fc0168f4053.png" extracted="true" mimetype="image/png" height="auto" width="auto" filename="images/figure-implementation-class-s121-right.png" semx-id="_b1445828-73e2-b93e-d6a7-1bf0981c2245"/></figure>

