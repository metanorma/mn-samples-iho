<title language="en" script="Latn" type="main">Information technology — Abstract Syntax Notation One (ASN.1): Specification of basic notation — Part 1:</title>

  
<title language="fr" script="Latn" type="title-intro">Technologies de l’information</title>

  
<title language="fr" script="Latn" type="title-main">Notation de syntaxe abstraite numéro un (ASN.1): Spécification de la notation de base</title>

  
<title language="fr" script="Latn" type="title-part">Partie 1:</title>

  
<title language="fr" script="Latn" type="main">Technologies de l’information — Notation de syntaxe abstraite numéro un (ASN.1): Spécification de la notation de base — Partie 1:</title>

  <uri type="src">https://www.iso.org/standard/68350.html</uri>
  <uri type="obp">https://www.iso.org/obp/ui/en/#!iso:std:68350:en</uri>
  <uri type="rss">https://www.iso.org/contents/data/standard/06/83/68350.detail.rss</uri><docidentifier type="metanorma-ordinal">[6]</docidentifier>
  <docidentifier type="ISO" primary="true">ISO/IEC 8824-1:2015</docidentifier>
  <docidentifier type="iso-reference">iso-reference ISO/IEC 8824-1:2015(E)</docidentifier>
  <docidentifier type="URN">URN urn:iso:std:iso-iec:8824:-1:stage-95.99</docidentifier><docidentifier scope="biblio-tag">ISO/IEC 8824-1:2015</docidentifier>
  <docnumber>8824</docnumber>
  <date type="published">
    <on>2015-11-12</on>
  </date>
  <contributor>
    <role type="publisher"/>
    <organization>
      
