        <identifier id="_8b42ddf7-94f4-4151-6f53-041a62b0b9ec">ISO/TC 211</identifier><fmt-identifier><tt><semx element="identifier" source="_8b42ddf7-94f4-4151-6f53-041a62b0b9ec">ISO/TC 211</semx></tt></fmt-identifier>
