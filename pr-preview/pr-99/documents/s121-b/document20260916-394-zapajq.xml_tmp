<title language="en" script="Latn" type="title-intro">Geographic information</title>

  
<title language="en" script="Latn" type="title-main">Land Administration Domain Model (LADM)</title>

  
<title language="en" script="Latn" type="main">Geographic information — Land Administration Domain Model (LADM)</title>

  
<title language="fr" script="Latn" type="title-intro">Information géographique</title>

  
<title language="fr" script="Latn" type="title-main">Modèle du domaine de l’administration des terres (LADM)</title>

  
<title language="fr" script="Latn" type="main">Information géographique — Modèle du domaine de l’administration des terres (LADM)</title>

  <uri type="src">https://www.iso.org/standard/51206.html</uri>
  <uri type="obp">https://www.iso.org/obp/ui/en/#!iso:std:51206:en</uri>
  <uri type="rss">https://www.iso.org/contents/data/standard/05/12/51206.detail.rss</uri><docidentifier type="metanorma-ordinal">[13]</docidentifier>
