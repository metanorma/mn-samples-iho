        <identifier id="_512df0c2-681f-4e7e-e08c-49e4feabed4c">ISO/TC 211</identifier><fmt-identifier><tt><semx element="identifier" source="_512df0c2-681f-4e7e-e08c-49e4feabed4c">ISO/TC 211</semx></tt></fmt-identifier>
